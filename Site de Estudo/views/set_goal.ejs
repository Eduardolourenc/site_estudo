<%- include('partials/head') %>
<section class="page-header">
  <div>
    <h1><i class="ph-duotone ph-target"></i> Meta do dia</h1>
    <p>Defina sua meta de horas de estudo para hoje (<%= todayStr %>).</p>
  </div>
</section>

<section class="card layout-single-col text-center">
  <div style="width:64px; height:64px; border-radius:16px; background: linear-gradient(135deg, var(--primary), var(--accent)); display:grid; place-items:center; margin:0 auto 1rem; box-shadow: var(--shadow-glow-primary);">
    <i class="ph-fill ph-flag-checkered" style="font-size:1.8rem; color:#fff;"></i>
  </div>
  <h2>Qual a sua meta de estudos para hoje?</h2>
  <p class="hint" style="margin-bottom:1.25rem;">Você pode ajustar isso a qualquer momento em Configurações.</p>
  <form method="POST" action="/set-goal" style="display:flex; flex-direction:column; gap:1rem;">
    <label style="text-align:left;">
      Meta (em horas)
      <input type="number" name="goal" step="0.5" min="0" value="<%= currentGoal %>" required style="font-size:1.4rem; text-align:center; font-weight:700;"/>
    </label>
    <button type="submit" class="btn-primary btn-block" style="font-size:1.05rem; padding:0.85rem;"><i class="ph-bold ph-check"></i> Definir e entrar</button>
  </form>
</section>
<%- include('partials/foot') %>
