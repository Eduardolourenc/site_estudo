<%- include('partials/head') %>
<section class="page-header">
  <div>
    <h1><i class="ph-duotone ph-timer"></i> Nova sessão de estudo</h1>
    <p>Use o cronômetro para controlar seu foco e registre tudo em poucos cliques.</p>
  </div>
</section>

<section class="layout-two-cols">
  <article class="card focus-card">
    <h2><i class="ph-duotone ph-hourglass-high"></i> Cronômetro</h2>
    <div class="timer focus-timer">
      <span id="timer-display" class="timer-display">00:00:00</span>
      <div class="timer-buttons">
        <button type="button" class="btn-secondary" id="timer-start"><i class="ph-fill ph-play"></i> Iniciar</button>
        <button type="button" class="btn-secondary" id="timer-pause"><i class="ph-fill ph-pause"></i> Pausar</button>
        <button type="button" class="btn-secondary" id="timer-reset"><i class="ph-bold ph-arrow-counter-clockwise"></i> Zerar</button>
        <button type="button" class="btn-primary" id="timer-transfer"><i class="ph-bold ph-arrow-right"></i> Usar tempo</button>
      </div>
      <p class="hint">Você pode deixar o cronômetro rolando enquanto estuda. Ao clicar em "Usar tempo", ele preenche os campos de horas e minutos automaticamente (pode ajustar depois).</p>
    </div>
  </article>

  <article class="card">
    <h2><i class="ph-duotone ph-note-pencil"></i> Registrar sessão</h2>
    <form method="POST" action="/study" class="form-grid">
      <label>
        <span><i class="ph-duotone ph-calendar"></i> Data</span>
        <input type="date" name="date" value="<%= todayStr %>" required />
      </label>

      <label>
        <span><i class="ph-duotone ph-book-open"></i> Matéria</span>
        <select name="subject_id" required>
          <% if (subjects.length === 0) { %>
            <option value="" disabled selected>Nenhuma matéria cadastrada</option>
          <% } %>
          <% subjects.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.name %></option>
          <% }); %>
        </select>
        <small><a href="/subjects">Gerenciar matérias</a></small>
      </label>

      <div class="form-row" style="grid-column: 1 / -1;">
        <label>
          <span><i class="ph-duotone ph-clock"></i> Horas</span>
          <input type="number" step="1" min="0" name="hours" id="hours-input" placeholder="0" />
        </label>
        <label>
          <span><i class="ph-duotone ph-timer"></i> Minutos</span>
          <input type="number" step="1" min="0" max="59" name="minutes" id="minutes-input" placeholder="0" />
        </label>
      </div>

      <label>
        <span><i class="ph-duotone ph-list-numbers"></i> Questões feitas (opcional)</span>
        <input type="number" min="0" name="questions" id="q-input" placeholder="0" />
      </label>

      <label>
        <span><i class="ph-duotone ph-check-circle"></i> Questões corretas (opcional)</span>
        <input type="number" min="0" name="correct" id="c-input" placeholder="0" />
      </label>

      <p class="hint" id="accuracy-preview" style="grid-column: 1 / -1; display:none;"></p>

      <button type="submit" class="btn-primary" style="grid-column: 1 / -1;"><i class="ph-bold ph-check"></i> Salvar sessão</button>
    </form>
  </article>
</section>

<script>
  (function() {
    const display = document.getElementById('timer-display');
    const startBtn = document.getElementById('timer-start');
    const pauseBtn = document.getElementById('timer-pause');
    const resetBtn = document.getElementById('timer-reset');
    const transferBtn = document.getElementById('timer-transfer');
    const hoursInput = document.getElementById('hours-input');
    const minutesInput = document.getElementById('minutes-input');
    const form = document.querySelector('form[action="/study"]');

    if (!display || !startBtn || !pauseBtn || !resetBtn || !transferBtn || !form) return;

    let startTime = null;
    let elapsedMs = 0;
    let timerId = null;

    function saveState() {
      localStorage.setItem('studyTimerState', JSON.stringify({ startTime: startTime, elapsedMs: elapsedMs }));
    }

    function loadState() {
      try {
        const state = JSON.parse(localStorage.getItem('studyTimerState') || '{}');
        if (state.elapsedMs) elapsedMs = state.elapsedMs;
        if (state.startTime) {
          startTime = state.startTime;
          timerId = setInterval(updateDisplay, 1000);
        }
      } catch (e) { console.error('Failed to load timer state:', e); }
    }

    function format(ms) {
      const totalSeconds = Math.floor(ms / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      const pad = n => String(n).padStart(2, '0');
      return pad(hours) + ':' + pad(minutes) + ':' + pad(seconds);
    }

    function updateDisplay() {
      const now = Date.now();
      const ms = elapsedMs + (startTime ? (now - startTime) : 0);
      display.textContent = format(ms);
    }

    function start() {
      if (timerId) return;
      startTime = Date.now();
      timerId = setInterval(updateDisplay, 1000);
      saveState();
    }

    function pause() {
      if (!timerId && !startTime) return;
      if (timerId) clearInterval(timerId);
      timerId = null;
      if (startTime) {
        elapsedMs += Date.now() - startTime;
        startTime = null;
      }
      updateDisplay();
      saveState();
    }

    function reset() {
      if (timerId) clearInterval(timerId);
      timerId = null;
      startTime = null;
      elapsedMs = 0;
      display.textContent = '00:00:00';
      saveState();
    }

    loadState();
    updateDisplay();

    startBtn.addEventListener('click', function(e) { e.preventDefault(); start(); });
    pauseBtn.addEventListener('click', function(e) { e.preventDefault(); pause(); });
    resetBtn.addEventListener('click', function(e) { e.preventDefault(); reset(); });

    transferBtn.addEventListener('click', function(e) {
      e.preventDefault();
      pause();
      const totalSeconds = Math.floor(elapsedMs / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);

      if (hours > 0 || minutes > 0) {
        if (hoursInput) hoursInput.value = hours;
        if (minutesInput) minutesInput.value = minutes;
        transferBtn.innerHTML = '<i class="ph-bold ph-check"></i> Preenchido!';
        setTimeout(() => { transferBtn.innerHTML = '<i class="ph-bold ph-arrow-right"></i> Usar tempo'; }, 2000);
      }
    });

    form.addEventListener('submit', function() {
      localStorage.removeItem('studyTimerState');
    });

    // Prévia de aproveitamento em tempo real
    const qInput = document.getElementById('q-input');
    const cInput = document.getElementById('c-input');
    const preview = document.getElementById('accuracy-preview');
    function updateAccuracyPreview() {
      const q = parseInt(qInput.value, 10) || 0;
      const c = parseInt(cInput.value, 10) || 0;
      if (q > 0) {
        const pct = Math.round((c / q) * 100);
        preview.style.display = 'block';
        preview.innerHTML = '<i class="ph-fill ph-target"></i> Aproveitamento estimado: <strong>' + pct + '%</strong>';
      } else {
        preview.style.display = 'none';
      }
    }
    qInput.addEventListener('input', updateAccuracyPreview);
    cInput.addEventListener('input', updateAccuracyPreview);
  })();
</script>
<%- include('partials/foot') %>
